# Place this map in the http block, outside the server block.
map $arg_v $argenmap_versioned_cache_control {
    default "";
    ~.+ "public, max-age=31536000, immutable";
}

server {
    listen 80;
    server_name example.invalid;
    root /var/www/argenmap;
    index index.html;

    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/css
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml;

    # Uncomment when the Nginx Brotli module is installed. The build already
    # provides .br files for the hashed startup assets.
    # brotli on;
    # brotli_static on;
    # brotli_comp_level 6;
    # brotli_types text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location = /service-worker.js {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location ~* ^/src/config/.*\.json$ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location ~* "^/(assets/js|src/styles/css)/.*\.[0-9a-f]{12}\.min\.(js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ~* ^/src/js/.*\.(js|css)$ {
        add_header Cache-Control $argenmap_versioned_cache_control always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
