<IfModule mod_headers.c>
  <FilesMatch "\.[0-9a-f]{12}\.min\.(js|css)(\.(br|gz))?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(index\.html|service-worker\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "^(data|preferences)\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <If "%{QUERY_STRING} =~ /(^|&)v=[^&]+/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/css text/html text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css text/html text/javascript application/javascript application/json application/manifest+json image/svg+xml
  </IfModule>
</IfModule>
